# -----------------------------------------------------------------------------
# Docker (compose.yaml). Kept first so later values can reference them.
# Set every password before the first "docker compose up"; "make env" fills them
# with random values.
# -----------------------------------------------------------------------------
HOST_UID=1000
HOST_GID=1000

APP_PORT=8047
VITE_PORT=5147
DB_FORWARD_PORT=5447
REDIS_FORWARD_PORT=6347
MAILPIT_DASHBOARD_PORT=8247

DB_SUPERUSER_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
DB_TEST_DATABASE=gasflow_testing
# Operator login for the backend maintenance override (gasflow_operator). Development
# and CI machines are operator machines, so "make env" fills it; production web and
# queue servers leave it empty, so the role does not exist there.
DB_OPERATOR_PASSWORD=

APP_NAME=GasFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8047

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (Docker service "postgres"). The roles are created on the first start
# by docker/postgres/init. The app runs as the restricted gasflow_app role;
# migrations run as the owner (php artisan migrate --database=pgsql_migrations).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=gasflow
DB_USERNAME=gasflow_app
DB_PASSWORD="${DB_APP_PASSWORD}"
DB_MIGRATION_USERNAME=gasflow_owner
DB_MIGRATION_PASSWORD="${DB_OWNER_PASSWORD}"
# Maintenance override connection (pgsql_maintenance, php artisan gasflow:maintenance).
# Operator machines only: never set these on web or queue servers.
DB_MAINTENANCE_USERNAME=gasflow_operator
DB_MAINTENANCE_PASSWORD="${DB_OPERATOR_PASSWORD}"

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# Mailpit (Docker service "mailpit", dev profile)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@gasflow.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
