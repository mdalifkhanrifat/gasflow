includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Used only by test fixtures until the first domain model (identity group).
        # PHPStan reports this entry as unmatched once a model uses the trait; remove it then.
        -
            identifier: trait.unused
            path: app/Shared/Lifecycle/HasLifecycle.php
