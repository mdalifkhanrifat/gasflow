{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "noEmit": true,
        "resolveJsonModule": true,
        "paths": { "@/*": ["./src/*"] },
        "types": ["vite/client", "node"]
    },
    "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
